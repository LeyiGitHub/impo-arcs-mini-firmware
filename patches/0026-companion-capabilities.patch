+void gadget_sound_receipt_watch(uint32_t id)
+{
+    if(!s_lock)return;
+    xSemaphoreTake(s_lock,portMAX_DELAY);
+    for(unsigned i=0;i<IMPO_RECEIPT_HISTORY;i++) {
+        impo_arcs_receipt_t *r=&s_receipts->entries[i];
+        if(r->playback_id==id){r->notify=true;if(r->state>=IMPO_PLAYBACK_COMPLETED)r->pending_event=true;}
