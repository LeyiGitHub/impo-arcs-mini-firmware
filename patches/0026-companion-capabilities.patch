+bool gadget_sound_receipt_event(impo_arcs_receipt_t *out)
+{
+    if(!s_lock || !out)return false;
+    bool found=false;xSemaphoreTake(s_lock,portMAX_DELAY);
+    for(unsigned n=0;n<IMPO_RECEIPT_HISTORY;n++) {
+        unsigned i=(s_receipts->next+n)%IMPO_RECEIPT_HISTORY;
+        if(s_receipts->entries[i].pending_event){*out=s_receipts->entries[i];found=true;break;}
+    }
+    xSemaphoreGive(s_lock);return found;
+}
+void gadget_sound_receipt_event_ack(uint32_t id)
+{
+    if(!s_lock)return;
+    xSemaphoreTake(s_lock,portMAX_DELAY);
+    for(unsigned i=0;i<IMPO_RECEIPT_HISTORY;i++)
+        if(s_receipts->entries[i].playback_id==id)s_receipts->entries[i].pending_event=false;
