+    s_rec.uptime_ms = 0;
     TaskHandle_t cur = xTaskGetCurrentTaskHandle();
     const char *name = cur ? pcTaskGetName(cur) : "?";
     strncpy(s_rec.task, name ? name : "?", sizeof(s_rec.task) - 1);
