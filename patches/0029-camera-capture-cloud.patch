+/* One camera job, owned parameters, and a generation-scoped async reply.
+ * Mirrors the shared ESP32 camera task; the Noise session never waits on DVP. */
+#include <stdlib.h>
+#include <string.h>
+#include "FreeRTOS.h"
+#include "task.h"
+#include "gadget_core.h"
+#include "link_glue_logic.h"
+#include "link_camera.h"
+typedef struct {
+    char request_id[64];
+    noise_ctrl_session_generation_t generation;
+    cJSON *params;
+} camera_job_t;
+static bool s_camera_job;
+static void camera_worker(void *arg)
+{
+    camera_job_t *job=arg;
+    cJSON *result=gadget_run_command("camera.capture",job->params);
+    cJSON_Delete(job->params);
+    link_result_to_upstream(result);
+    noise_ctrl_send_command_result(job->generation,job->request_id,result);
+    free(job);
+    taskENTER_CRITICAL(); s_camera_job=false; taskEXIT_CRITICAL();
+    vTaskDelete(NULL);
+}
+static cJSON *camera_error(const char *why)
+{
+    cJSON *r=gadget_command_error(why);
+    link_result_to_upstream(r);
+    return r;
+}
+cJSON *link_camera_invoke(const cJSON *params,const char *request_id,
+                          noise_ctrl_session_generation_t generation)
+{
+    if (!generation || !request_id || !*request_id || strlen(request_id)>=64)
+        return camera_error("invalid camera request identity");
+    taskENTER_CRITICAL();
+    bool busy=s_camera_job;
+    if (!busy) s_camera_job=true;
+    taskEXIT_CRITICAL();
+    if (busy) return camera_error("camera busy");
+    camera_job_t *job=calloc(1,sizeof(*job));
+    cJSON *async=cJSON_CreateObject();
+    if (!job || !async || !cJSON_AddBoolToObject(async,"_async",true)) goto failed;
+    job->generation=generation;
+    memcpy(job->request_id,request_id,strlen(request_id)+1);
+    job->params=params ? cJSON_Duplicate(params,true) : cJSON_CreateObject();
+    if (!job->params) goto failed;
+    if (xTaskCreate(camera_worker,"camera_capture",8192/sizeof(StackType_t),job,4,NULL)!=pdPASS)
+        goto failed;
+    return async;
+failed:
+    if (job) cJSON_Delete(job->params);
+    free(job); cJSON_Delete(async);
+    taskENTER_CRITICAL(); s_camera_job=false; taskEXIT_CRITICAL();
+    return camera_error("camera worker allocation failed");
+}
