+/* ---- camera.capture: official JPEG/base64 result contract ---- */
+static cJSON *cmd_camera_capture(const cJSON *params)
+{
+    (void)params;
+    uint8_t *jpeg=NULL;
+    size_t bytes=0,encoded=0;
+    int rc=gadget_board_get()->camera_capture(&jpeg,&bytes);
+    if (rc || !jpeg || !bytes || bytes>IMPO_CAMERA_JPEG_MAX) {
+        free(jpeg);
+        return gadget_command_error("camera capture failed or camera busy");
+    }
+    size_t cap=(bytes+2)/3*4+1;
+    char *data=malloc(cap);
+    if (!data || mbedtls_base64_encode((unsigned char *)data,cap,&encoded,jpeg,bytes)) {
+        free(jpeg); free(data);
+        return gadget_command_error("camera encoding allocation failed");
+    }
+    free(jpeg); data[encoded]='\0';
+    cJSON *payload=cJSON_CreateObject();
+    bool ok=payload && cJSON_AddStringToObject(payload,"format","jpeg-base64") &&
+        cJSON_AddStringToObject(payload,"data_base64",data) &&
+        cJSON_AddNumberToObject(payload,"width",IMPO_CAMERA_WIDTH) &&
+        cJSON_AddNumberToObject(payload,"height",IMPO_CAMERA_HEIGHT);
+    free(data);
+    if (!ok) { cJSON_Delete(payload); return gadget_command_error("camera result allocation failed"); }
+    return gadget_command_ok_payload(payload);
+}
