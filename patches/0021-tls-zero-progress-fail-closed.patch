+static int tls_send(void *ctx, const unsigned char *buf, size_t len)
+{
+    int ret = mbedtls_net_send(ctx, buf, len);
+    /* mbedTLS's flush loop returns zero as success to ssl_write_real(), even
+     * when a zero-returning BIO left the record unfinished. Never acknowledge
+     * that unsent application data as written. */
+    return ret == 0 && len > 0 ? MBEDTLS_ERR_NET_CONN_RESET : ret;
+}
