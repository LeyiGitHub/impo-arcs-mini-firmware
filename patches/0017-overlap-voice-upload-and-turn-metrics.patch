+/* Only this worker encodes/uploads. The capture task publishes complete
+ * frames under a short mutex. Full chunks are divisible by 3; padding is
+ * emitted exactly once, with the final JSON terminator. */
+static void upload_turn(uint32_t epoch)
+{
+    uint64_t started = plat_uptime_ms();
+    int handle = impo_link_stream_open_ctx("/chat/stream", "application/json", NULL,
+        NULL, 0, true, &s_note_sink, (void *)(uintptr_t)epoch);
+    xSemaphoreTake(s_lock, portMAX_DELAY);
+    bool live = live_locked(epoch) && !s_note_failed;
+    if (live && handle >= 0 && !s_note_done) s_note = handle;
+    if (handle < 0 && live) fail_locked();
+    xSemaphoreGive(s_lock);
+    if (!live || handle < 0) { impo_link_stream_cancel(handle); return; }
+    if (impo_link_stream_send(handle, NOTE_HEAD, strlen(NOTE_HEAD), false) != 0) {
+        impo_link_stream_cancel(handle);
+        xSemaphoreTake(s_lock, portMAX_DELAY);
+        if (live_locked(epoch)) { s_note = -1; fail_locked(); }
+        xSemaphoreGive(s_lock);
+        return;
+    }
+    size_t off = 0;
+    for (;;) {
+        xSemaphoreTake(s_lock, portMAX_DELAY);
+        live = live_locked(epoch) && !s_note_failed && !s_interrupt && !s_stop && !s_touch;
+        size_t available = s_published - off;
+        bool sealed = s_sealed;
+        xSemaphoreGive(s_lock);
+        if (!live || plat_uptime_ms() - started >= UPLOAD_WAIT_MS) break;
+        if (!sealed && available < STAGE_BYTES) {
+            vTaskDelay(pdMS_TO_TICKS(10));
+            continue;
+        }
+        size_t n = available < STAGE_BYTES ? available : STAGE_BYTES;
+        bool last = sealed && n == available;
+        size_t e = gadget_base64(s_recording + off, n, s_encoded);
+        if (last) {
+            memcpy(s_encoded + e, NOTE_TAIL, sizeof(NOTE_TAIL)-1);
+            e += sizeof(NOTE_TAIL)-1;
+        }
+        if (last) {
+            xSemaphoreTake(s_lock, portMAX_DELAY);
+            s_final_sending = true;
+            xSemaphoreGive(s_lock);
+        }
+        if (impo_link_stream_send(handle, s_encoded, e, last) != 0) break;
+        off += n;
+        xSemaphoreTake(s_lock, portMAX_DELAY);
+        if (live_locked(epoch)) {
+            s_uploaded = off;
+            s_stats.queued_bytes = (uint32_t)off;
+            if (last) {
+                s_queued = true;
+                mark_locked(IMPO_VOICE_UPLOAD_QUEUED);
+            }
+        }
+        xSemaphoreGive(s_lock);
+        if (last) return; /* retain handle until ACK or explicit cancellation */
+    }
+    impo_link_stream_cancel(handle);
+    xSemaphoreTake(s_lock, portMAX_DELAY);
+    if (live_locked(epoch)) {
+        s_note = -1;
+        if (s_stop || s_touch || s_interrupt) mark_locked(IMPO_VOICE_CANCELLED);
+        else fail_locked();
+    }
+    xSemaphoreGive(s_lock);
+}
+static void upload_task(void *arg)
+{
+    (void)arg;
+    for (;;) {
+        xSemaphoreTake(s_lock, portMAX_DELAY);
+        bool run = s_upload_pending && s_active;
+        uint32_t epoch = s_epoch;
+        if (run) {
+            s_upload_pending = false;
+            s_upload_running = true;
+            mark_locked(IMPO_VOICE_UPLOAD_START);
+        }
+        xSemaphoreGive(s_lock);
+        if (run) {
+            upload_turn(epoch);
+            xSemaphoreTake(s_lock, portMAX_DELAY);
+            s_stats.upload_stack_free_bytes = (uint32_t)uxTaskGetStackHighWaterMark(NULL) * sizeof(StackType_t);
+            s_upload_running = false;
+            xSemaphoreGive(s_lock);
+        }
+        vTaskDelay(pdMS_TO_TICKS(10));
+    }
 }
 
