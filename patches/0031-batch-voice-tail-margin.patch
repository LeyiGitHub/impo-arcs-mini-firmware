+int gadget_voice_tail_configure(uint32_t keep_ms)
+{
+    if (keep_ms && (keep_ms < 200 || keep_ms > 1000)) return -1;
+    if (s_lock) xSemaphoreTake(s_lock, portMAX_DELAY);
+    bool busy = s_state != GADGET_VOICE_IDLE || s_active || s_upload_running || s_upload_pending || s_session;
