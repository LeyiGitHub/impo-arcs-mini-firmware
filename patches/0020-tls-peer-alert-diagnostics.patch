+static void log_stream_failure(plat_tls_t *t, const char *what, int ret)
+{
+    log_error(what, ret);
+    uint64_t now = plat_uptime_ms();
+    LISA_LOGE(TAG, "tls_progress phase=%s age_ms=%llu tx_bytes=%llu rx_bytes=%llu",
+        what, (unsigned long long)(now-t->started_ms),
+        (unsigned long long)t->tx_bytes, (unsigned long long)t->rx_bytes);
+    LISA_LOGE(TAG, "tls_idle tx_ms=%llu rx_ms=%llu",
+        (unsigned long long)(now-t->last_tx_ms), (unsigned long long)(now-t->last_rx_ms));
+    if (ret == MBEDTLS_ERR_SSL_FATAL_ALERT_MESSAGE) {
+        /* Both pinned ListenAI ABIs use mbedTLS 2.x and retain this record
+         * until the next read. Expose only the alert's two numeric fields;
+         * never dump TLS application data, keys or request contents. */
+        if (t->ssl.in_msgtype == MBEDTLS_SSL_MSG_ALERT && t->ssl.in_msg && t->ssl.in_msglen == 2) {
+            LISA_LOGE(TAG, "tls_peer_alert level=%u description=%u",
+                (unsigned)t->ssl.in_msg[0], (unsigned)t->ssl.in_msg[1]);
+        } else LISA_LOGE(TAG, "tls_peer_alert unavailable");
+    }
+}
+
 plat_tls_t *plat_tls_connect(const char *host, uint16_t port, uint32_t timeout_ms, int *err)
 {
     return plat_tls_connect_named(host, port, NULL, timeout_ms, err);
